# ==============================================================================
# Moting (모팅) Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your API credentials:
#   cp .env.example .env.local
#
# Note: If any API key is left blank, Moting will automatically operate in
# mock/demo fallback mode with realistic simulated responses.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (LLM, Document Ingestion, Evaluation, TTS, Embeddings)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Model Overrides
# GEMINI_MODEL_SMART=gemini-3.8-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts
# GEMINI_MODEL_EMBED=gemini-embedding-001

# ------------------------------------------------------------------------------
# 2. Deepgram (Real-time Korean Speech-to-Text & VAD)
# Get your API key from Deepgram Console: https://console.deepgram.com/
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 3. Simli (Real-time WebRTC Lip-Sync Video Avatars)
# Get your API key from Simli Developer Platform: https://app.simli.com/
# ------------------------------------------------------------------------------
SIMLI_API_KEY=your_simli_api_key_here

# ------------------------------------------------------------------------------
# 4. Storage & Database (Optional Supabase Integration)
# By default, Moting uses local FileStore (.data/) for zero-config persistence.
# To connect Supabase, configure your project credentials below:
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 5. Admin Authentication
# Used for accessing the review inspection dashboard (/admin)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=admin
